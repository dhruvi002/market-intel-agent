*.arrow
*.pkl
*.safetensors
*.bin
*.pt
*.ckpt

# ── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/*.ipynb   # commit intentionally, not accidentally

