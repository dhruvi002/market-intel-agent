# ──────────────────────────────────────────────────────────────────────────────
# Market Intelligence Agent — CLOUD environment variables
# Copy to .env.cloud and fill in real values. .env.cloud is gitignored.
#
# All services below are on free tiers with NO credit card required:
#   • Supabase     — free Postgres (500 MB, no CC)    https://supabase.com
#   • Upstash      — free Redis (10k commands/day)    https://upstash.com
#   • Qdrant Cloud — free 1 GB cluster                https://cloud.qdrant.io
#   • HF Spaces    — free Docker runtime              https://huggingface.co/spaces
#   • Vercel       — free frontend hosting            https://vercel.com
# ──────────────────────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Supabase (Postgres) ───────────────────────────────────────────────────────
# From your Supabase project: Settings → Database → Connection string (URI)
# Use the Transaction Pooler (port 6543) for Supabase free tier connection limits
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Upstash (Redis) ───────────────────────────────────────────────────────────
# From your Upstash console: copy the "Redis URL" (rediss:// for TLS)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# From your Qdrant Cloud cluster: copy the endpoint URL and API key
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-cloud-api-key>

# ── MinIO / Object storage ────────────────────────────────────────────────────
# Optional: leave blank to disable PDF archiving in cloud mode.
# If using Cloudflare R2 or Backblaze B2 (both S3-compatible, free tier):
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true

# ── Langfuse (optional — self-hosted elsewhere or leave blank) ────────────────
# If you have a self-hosted Langfuse instance (e.g. on a VPS or Railway):
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── LLM APIs (all free, no CC required) ──────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras (optional fallback): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── Search ────────────────────────────────────────────────────────────────────
# Tavily: https://app.tavily.com/  (1000 searches/month free, no CC)
TAVILY_API_KEY=
